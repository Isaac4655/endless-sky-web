mission "FW Early Warning 3"
	autosave
	landing
	name "Harmony Lost"
	description "The peace talks with the Navy have broken down. Another battle seems inevitable. Return to <destination> with JJ to prepare."
	source "Harmony"
	destination "Deep"
	passengers 1
	to offer
		has "FW Early Warning 2: done"
	on fail
