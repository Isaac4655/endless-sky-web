	repeat
	name "Mystery delivery to <planet>"
	description "Deliver a package to <destination>. Payment is <payment>."
	source
		attributes "deep"
	destination
		distance 7 16
		government "Republic" "Free Worlds" "Syndicate" "Neutral" "Hai" "Quarg"
		not attributes "station"
	cargo "mystery package" 1
	to offer
