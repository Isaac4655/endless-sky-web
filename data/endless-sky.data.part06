outfit "Thruster (Stellar Class)"
	plural "Thrusters (Stellar Class)"
	category "Engines"
	series "Engines"
	index 04061
	"cost" 2733000
	thumbnail "outfit/huge korath thruster"
	"mass" 118
	"outfit space" -118
