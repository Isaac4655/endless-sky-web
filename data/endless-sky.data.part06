outfit "Microbot Grinder"
	category "Guns"
	series "Guns"
	index 04080
	thumbnail "outfit/unknown"
	"mass" 182
	"outfit space" -212
	"weapon capacity" -112
	"required crew" 20
	"gun ports" -1
	"spinal mount" -1
	"unplunderable" 1
