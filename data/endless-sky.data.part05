phrase "pirate subphrase 4"
	phrase
		"sinister names"
	word
		"%'s "
	phrase
		"pirate nouns" 113
		"pirate nouns that work after bad outcomes" 27
		"bad outcomes" 52
	# When making a word ending in "s" possessive, only add an apostrophe.
	replace
		"s%'s" "s'"
		"%" ""

