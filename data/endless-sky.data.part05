outfit "Energy Blaster"
	category "Guns"
	series "Guns"
	index 01010
	cost 16000
	thumbnail "outfit/blaster"
	"mass" 5
	"outfit space" -5
	"weapon capacity" -5
	"gun ports" -1
	weapon
