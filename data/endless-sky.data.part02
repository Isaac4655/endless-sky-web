# Gegno Civilians:

ship "Shale"
	sprite "ship/gegno shale"
	thumbnail "thumbnail/gegno shale"
	"administrative cost" 1
	attributes
		category "Transport"
		licenses
			"Gegno Civilian"
		"cost" 148000
		"shields" 0
