## Compatibility patch for pre-0.11.1 saves to revert Teciimach Canisters back to EMP Torpedoes.
mission "Remnant: Teciimach Compatibility"
	landing
	invisible
	non-blocking
	to offer
		has "event: remnant: teciimach deployment"
	on offer
		event "remnant: teciimach compatibility"
		fail

event "remnant: teciimach compatibility"
	outfitter "Remnant"
		add "EMP Torpedo Bay"
		add "EMP Torpedo"
		add "EMP Torpedo Storage Bay"
		remove "Teciimach Canister"
		remove "Teciimach Canister Rack"
	outfitter "Remnant Core"
		add "EMP Torpedo"
		remove "Teciimach Canister"



event "remnant: shattered light"
	shipyard "Remnant"
		add "Modified Dromedary"



event "remnant: shattered light research"

event "remnant: tubfalet appearance"
	fleet "Korath Raid"
		add variant 1
			"Tubfalet"
			"'olofez" 3
	fleet "Korath Ember Waste Raid"
		add variant 3
			"Tubfalet"
			"'olofez" 3
	fleet "Korath Large Raid"
		add variant 3
			"Tubfalet" 2
			"'olofez" 6

event "remnant: inhibitor turret available"
	outfitter "Remnant"
		add "Inhibitor Turret"
	outfitter "Remnant Core"
		add "Inhibitor Turret"
